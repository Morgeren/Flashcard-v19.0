    "sage": "#A8B89A",
    "naturalWood": "#D8B88C",
    "softRose": "#D5A59A",
    "icon": "Countryside Book",
    "seasonIndependent": true,
    "notes": [
      "Warm Cream and Surface White remain the permanent light-mode foundation.",
      "The Countryside Book app icon and typography do not change with the season.",
      "The original muted brand reference #777B6E is retained as brand metadata; the accessible semantic text-secondary token is darkened to #646A60 for normal text on Warm Cream."
    ]
  },
  "accessibility": {
    "standard": "WCAG 2.2 contrast calculation using relative luminance",
    "normalTextMinimum": 4.5,
    "largeTextMinimum": 3.0,
    "nonTextUiMinimum": 3.0,
    "validationScope": "Configured semantic foreground/background pairings only; final component-level testing remains required after integration.",
