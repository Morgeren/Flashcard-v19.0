{
  "schemaVersion": "1.0.0",
  "application": "Nihongo Study Deck V19.1",
  "status": "prepared_for_review_not_integrated",
  "concept": "Cozy Japanese Countryside — Four Seasons",
  "themeSystem": {
    "mode": "automatic",
    "timezone": "Asia/Tokyo",
    "calendar": "gregorian-month-boundaries",
    "manualSeasonOverride": false,
    "schedule": {
      "reference": "Japanese seasonal product calendar",
      "seasons": {
        "spring": {
          "start": {
            "month": 3,
            "day": 1
          },
          "end": {
            "month": 5,
            "day": 31
          }
        },
        "summer": {
          "start": {
            "month": 6,
            "day": 1
          },
          "end": {
            "month": 8,
            "day": 31
          }
        },
        "autumn": {
          "start": {
            "month": 9,
            "day": 1
          },
          "end": {
            "month": 11,
            "day": 30
          }
        },
        "winter": {
          "start": {
            "month": 12,
            "day": 1
          },
          "end": {
            "month": 2,
            "day": "last"
          }
        }
      },
      "leapYearHandling": "Winter ends on February 28 in common years and February 29 in leap years; the following day belongs to Spring."
    },
    "fallbackSeason": null,
    "dateSource": "Use the current instant converted to Asia/Tokyo before reading its calendar month and day.",
    "boundaryBehavior": "If the app remains open across a seasonal boundary, re-evaluate when it becomes visible or active again.",
    "fallbackBehavior": "If the current instant cannot be converted to Asia/Tokyo, use the permanent brand foundation and do not apply a guessed seasonal override.",
    "appearanceMode": {
      "source": "existing saved studyPrefs.theme preference from V19.0",
      "supportedModes": [
        "light",
        "dark"
      ],
      "preserveUserPreference": true,
      "seasonalThemeDoesNotOverrideAppearanceMode": true,
      "seasonalAccentsApplyInBothModes": true,
      "manualSeasonSelector": false
    }
  },
  "transition": {
    "enabled": true,
    "durationMs": 900,
    "easing": "ease-in-out",
    "reducedMotionDurationMs": 0,
    "reducedMotionMediaQuery": "(prefers-reduced-motion: reduce)",
    "updateTriggers": [
      "application-start",
      "visibility-resume",
      "calendar-date-recheck"
    ],
    "animatedProperties": [
      "color",
      "background-color",
      "border-color",
      "fill",
      "stroke"
    ],
    "preserveActiveLearningState": true,
    "requiresPageReload": false,
    "implementationStatus": "configuration_only_not_implemented"
  },
  "brand": {
    "background": "#F5F0E4",
    "surface": "#FFFCF5",
    "textPrimary": "#353B32",
    "textSecondaryReference": "#777B6E",
    "textSecondaryAccessible": "#646A60",
